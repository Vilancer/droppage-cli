{
  "name": "droppage",
  "version": "0.5.1",
  "mcpName": "io.github.Vilancer/droppage",
  "description": "Share analyst reports and dashboards as a live link",
  "type": "module",
  "license": "Apache-2.0",
  "author": "Vilancer",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Vilancer/droppage-cli.git"
  },
  "homepage": "https://droppage.dev",
  "bugs": {
    "url": "https://github.com/Vilancer/droppage-cli/issues"
  },
  "keywords": [
    "html",
    "publish",
    "share",
    "share-html",
    "html-to-link",
    "report",
    "analyst",
    "dashboard",
    "analytics",
    "jupyter",
    "plotly",
    "cli",
    "link",
    "access-control",
    "agents",
    "mcp",
    "mcp-server",
    "claude-code"
  ],
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "droppage": "dist/cli.js"
  },
  "files": [
    "dist",
    "NOTICE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "dev": "tsx src/cli.ts",
    "build": "tsup",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepublishOnly": "node -e \"require('fs').accessSync('.publish-ok')\" && npm run test && npm run build"
  },
  "dependencies": {
    "@inquirer/prompts": "8.5.2",
    "@modelcontextprotocol/server": "2.4.0",
    "@supabase/supabase-js": "2.110.8",
    "bcryptjs": "3.0.3",
    "commander": "15.0.0",
    "conf": "15.1.0",
    "dotenv": "17.4.2",
    "nanoid": "5.1.16",
    "open": "11.0.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "2.4.0",
    "@types/node": "^22.15.0",
    "tsup": "8.5.1",
    "tsx": "4.23.1",
    "typescript": "5.9.3",
    "vitest": "4.1.10"
  }
}
